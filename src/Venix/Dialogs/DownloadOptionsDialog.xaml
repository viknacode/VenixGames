<UserControl x:Class="Venix.Dialogs.DownloadOptionsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Venix.Core"
             Width="680">
    <Border Style="{StaticResource Glass}" Background="{DynamicResource Glass.Strong}" CornerRadius="30" Padding="0" Effect="{StaticResource Shadow.Lift}">
        <Grid MaxHeight="640">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="28,26,22,0">
                <StackPanel>
                    <TextBlock Text="Opções de download" Style="{StaticResource T.H2}" FontSize="22" />
                    <TextBlock x:Name="Sub" Style="{StaticResource T.Label}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Btn.Circle}" Content="{x:Static core:Icons.Close}" FontSize="12" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="OnClose" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,18,28,6">
                <TextBox x:Name="Filter" Style="{StaticResource Input}" Tag="Filtrar opções…" core:Ui.Icon="{x:Static core:Icons.Search}" TextChanged="OnFilter" />
                <WrapPanel x:Name="Sources" Margin="0,12,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                <ItemsControl x:Name="List" Margin="22,4,16,8">
                    <!-- options are grouped by kind: the full game first, then updates, then fixes (empty sections never appear) -->
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,10,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Chip}" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="{DynamicResource Text.2}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="hint" Style="{StaticResource T.Label}" Margin="0,3,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="Atualizações">
                                            <Setter TargetName="hint" Property="Text" Value="Aplicar sobre o jogo já instalado" />
                                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Patches">
                                            <Setter TargetName="hint" Property="Text" Value="Patch ou hotfix para o jogo já instalado" />
                                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Fixes">
                                            <Setter TargetName="hint" Property="Text" Value="Correções para um jogo já instalado" />
                                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="core:SourceEntry">
                            <RadioButton GroupName="opt" Checked="OnPick" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,8"
                                         IsChecked="{Binding Preselected, Mode=OneTime}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" CornerRadius="18" Padding="18,14" Background="{DynamicResource Glass.Fill}" BorderBrush="{DynamicResource Glass.Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="t" Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="m" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Text.3}" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <Border x:Name="dot" Grid.Column="1" Width="22" Height="22" CornerRadius="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource Line.Strong}" BorderThickness="1.5">
                                                    <TextBlock x:Name="ck" Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Check}" FontSize="10" Visibility="Collapsed" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Glass.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Ink}" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Ink.Text}" />
                                                <Setter TargetName="m" Property="Opacity" Value="0.8" />
                                                <Setter TargetName="dot" Property="Background" Value="{DynamicResource Ink.Text}" />
                                                <Setter TargetName="dot" Property="BorderThickness" Value="0" />
                                                <Setter TargetName="ck" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ck" Property="Foreground" Value="{DynamicResource Ink}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- footer -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,18,28,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Salvar em" Style="{StaticResource T.Label}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="SavePath" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            <Button Style="{StaticResource Btn.Link}" Content="Alterar" Margin="12,0,0,0" Click="OnChangePath" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="Cancelar" Click="OnClose" Margin="0,0,10,0" />
                        <Button x:Name="Go" Style="{StaticResource Btn.Primary}" Click="OnDownload" IsEnabled="False" Padding="24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Download}" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Text="Baixar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
