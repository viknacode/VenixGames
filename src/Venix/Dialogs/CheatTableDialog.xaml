<UserControl x:Class="Venix.Dialogs.CheatTableDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Venix.Core"
             Width="720">
    <Border Style="{StaticResource Glass}" Background="{DynamicResource Glass.Strong}" CornerRadius="30" Padding="0" Effect="{StaticResource Shadow.Lift}">
        <Grid MaxHeight="680">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="28,26,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="17" Background="{DynamicResource Ink}">
                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Cheat}" FontSize="20" Foreground="{DynamicResource Ink.Text}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource T.H2}" FontSize="22" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FileText" Style="{StaticResource T.Label}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn.Circle}" Content="{x:Static core:Icons.Close}" FontSize="12" VerticalAlignment="Top" Click="OnClose" />
            </Grid>

            <WrapPanel x:Name="Chips" Grid.Row="1" Margin="28,18,28,8" />

            <!-- entries -->
            <Grid Grid.Row="2">
                <TextBlock x:Name="Loading" Style="{StaticResource T.Body}" Text="Baixando e lendo a tabela…" Margin="28,16" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                    <ItemsControl x:Name="Entries" Margin="22,4,16,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="core:CheatEntryInfo">
                                <Border CornerRadius="14" Padding="12,9" Margin="{Binding Indent}" Background="{DynamicResource Glass.Soft}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" Tag="{Binding IsGroup}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource T.Icon}" Text="{Binding Icon}" FontSize="12" Foreground="{DynamicResource Text.3}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource T.Label}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,16,28,22">
                <StackPanel>
                    <StackPanel x:Name="LinkPanel" Margin="0,0,0,14">
                        <TextBlock Text="Vincular a um jogo da biblioteca" Style="{StaticResource T.Label}" Margin="2,0,0,8" />
                        <WrapPanel x:Name="LibraryChips" />
                    </StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="GithubBtn" Style="{StaticResource Btn.Link}" Content="Ver no GitHub" Click="OnGithub" />
                            <Button Style="{StaticResource Btn.Link}" Content="Abrir pasta" Click="OnFolder" Margin="18,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="LinkBtn" Style="{StaticResource Btn}" Content="Vincular" Click="OnLink" Margin="0,0,10,0" IsEnabled="False" />
                            <Button x:Name="OpenBtn" Style="{StaticResource Btn.Primary}" Click="OnOpen" Padding="22,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Cheat}" FontSize="13" Margin="0,0,10,0" />
                                    <TextBlock Text="Ativar cheats" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
