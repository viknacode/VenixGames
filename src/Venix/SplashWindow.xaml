<Window x:Class="Venix.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Venix.Core"
        Title="Venix" Width="560" Height="420" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        Icon="Assets/venix.ico" FontFamily="{StaticResource Font.Text}" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal" MouseLeftButtonDown="OnDrag">
    <Grid Margin="24">
        <!-- card -->
        <Border CornerRadius="30" Background="{DynamicResource Bg.Base}" Effect="{StaticResource Shadow.Lift}" />
        <Border CornerRadius="30" ClipToBounds="True">
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="420" Height="320" Canvas.Left="-120" Canvas.Top="-160" Fill="{DynamicResource Bg.Blob1}">
                    <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="380" Height="300" Canvas.Left="260" Canvas.Top="200" Fill="{DynamicResource Bg.Blob2}">
                    <Ellipse.Effect><BlurEffect Radius="100" /></Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Border>
        <Border CornerRadius="30" BorderBrush="{DynamicResource Glass.Border}" BorderThickness="1" Padding="34,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Logo" Width="52" Height="52" CornerRadius="17" Background="{DynamicResource Ink}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="LogoScale" /></Border.RenderTransform>
                        <Path Data="M 15,17 L 26,37 L 37,17" Stroke="{DynamicResource Ink.Text}" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="venix" Style="{StaticResource T.H1}" FontSize="28" FontWeight="SemiBold" Margin="0,-4,0,0" />
                        <TextBlock Text="games launcher" Style="{StaticResource T.Label}" Margin="0,-3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,14">
                    <Grid>
                        <TextBlock x:Name="Status" Text="Iniciando…" Style="{StaticResource T.H3}" FontWeight="Medium" />
                        <TextBlock x:Name="Counter" Style="{StaticResource T.Label}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid Margin="0,12,0,0" Height="6">
                        <Border CornerRadius="3" Background="{DynamicResource Track}" />
                        <Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource Ink}" HorizontalAlignment="Left" Width="0" />
                        <Border x:Name="Indeterminate" CornerRadius="3" Background="{DynamicResource Ink}" HorizontalAlignment="Left" Width="90" Opacity="0.85">
                            <Border.RenderTransform><TranslateTransform x:Name="IndeterminateX" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- per-source status -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="-6,0,-14,0">
                    <ItemsControl x:Name="SourceList" Margin="6,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="core:DownloadSource">
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Text.3}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="st" Grid.Column="2" Text="{Binding StatusLabel}" FontSize="12" Foreground="{DynamicResource Text.3}" Margin="12,0,0,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="ok">
                                        <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Success}" />
                                        <Setter TargetName="st" Property="Text" Value="{Binding Count, StringFormat={}{0:N0} jogos}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="error">
                                        <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Danger}" />
                                        <Setter TargetName="st" Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="syncing">
                                        <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="Hint" Grid.Row="2" Style="{StaticResource T.Body}" FontSize="12.5" VerticalAlignment="Top" Visibility="Collapsed" />

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock x:Name="Version" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                    <Button x:Name="SkipBtn" Style="{StaticResource Btn}" Content="Continuar sem esperar" HorizontalAlignment="Right"
                            Height="36" Padding="16,0" FontSize="12.5" Click="OnSkip" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
