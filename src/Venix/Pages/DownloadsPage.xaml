<UserControl x:Class="Venix.Pages.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Venix.Core">
    <UserControl.Resources>
        <!-- active / paused download card -->
        <DataTemplate x:Key="ActiveCard" DataType="core:DownloadItem">
            <Border Style="{StaticResource Glass}" CornerRadius="28" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="122" CornerRadius="20" Background="{DynamicResource Placeholder}">
                        <Border CornerRadius="20">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill" core:Img.DecodeWidth="520" core:Img.Urls="{Binding Converter={x:Static core:Conv.DownloadArt}}" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,6,16,6" VerticalAlignment="Center">
                        <Grid>
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="{Binding GameTitle}" Style="{StaticResource T.H2}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource T.Big}" FontSize="38" />
                                <TextBlock Text="%" Style="{StaticResource T.Label}" FontSize="16" VerticalAlignment="Bottom" Margin="3,0,0,8" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource Progress}" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,14,0,14" />
                        <WrapPanel>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Download}" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding SpeedLabel}" FontSize="12" Foreground="{DynamicResource Text.2}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.People}" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding PeersLabel}" FontSize="12" Foreground="{DynamicResource Text.2}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Clock}" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding EtaLabel}" FontSize="12" Foreground="{DynamicResource Text.2}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Disk}" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="{DynamicResource Text.2}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource Btn.Circle}" Content="{x:Static core:Icons.Pause}" Click="OnPause" ToolTip="Pausar" Margin="0,0,0,8"
                                Visibility="{Binding CanPause, Converter={x:Static core:Conv.Visible}}" />
                        <Button Style="{StaticResource Btn.Circle}" Content="{x:Static core:Icons.Play}" Click="OnResume" ToolTip="Retomar" Margin="0,0,0,8"
                                Visibility="{Binding CanResume, Converter={x:Static core:Conv.Visible}}" Background="{DynamicResource Ink}" Foreground="{DynamicResource Ink.Text}" />
                        <Button Style="{StaticResource Btn.Circle}" Content="{x:Static core:Icons.Folder}" Click="OnOpen" ToolTip="Abrir pasta" Margin="0,0,0,8" />
                        <Button Style="{StaticResource Btn.Circle}" Content="{x:Static core:Icons.Delete}" Click="OnRemove" ToolTip="Cancelar download" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- finished row -->
        <DataTemplate x:Key="DoneRow" DataType="core:DownloadItem">
            <Border CornerRadius="20" Padding="10" Margin="0,0,0,8" Background="{DynamicResource Glass.Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="56" CornerRadius="12" Background="{DynamicResource Placeholder}">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill" core:Img.DecodeWidth="240" core:Img.Urls="{Binding Converter={x:Static core:Conv.DownloadArt}}" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameTitle}" Style="{StaticResource T.H3}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource T.Label}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeLabel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Content="Abrir pasta" Click="OnOpen" Height="36" Padding="16,0" FontSize="12.5" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Btn.Circle}" Width="36" Height="36" Content="{x:Static core:Icons.Close}" FontSize="11" Click="OnRemove" ToolTip="Remover da lista" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,8,28,32">
            <!-- summary -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Glass}" Padding="24,20" Background="{DynamicResource Ink}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Velocidade total" Style="{StaticResource T.Label}" Foreground="{DynamicResource Ink.Text}" Opacity="0.6" />
                        <TextBlock x:Name="TotalSpeed" Style="{StaticResource T.Big}" Foreground="{DynamicResource Ink.Text}" Text="0 B/s" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="Em andamento" Style="{StaticResource T.Label}" />
                        <TextBlock x:Name="ActiveCount" Style="{StaticResource T.Big}" Text="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Glass}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="Concluídos" Style="{StaticResource T.Label}" />
                        <TextBlock x:Name="DoneCount" Style="{StaticResource T.Big}" Text="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ActiveHeader" Text="Fila" Style="{StaticResource T.H2}" Margin="6,0,0,14" />
            <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ActiveCard}" />

            <Border x:Name="Empty" Style="{StaticResource Glass}" Padding="40" CornerRadius="28" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Glass.Strong}">
                        <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Download}" FontSize="22" Foreground="{DynamicResource Text}" />
                    </Border>
                    <TextBlock Text="Nenhum download em andamento" Style="{StaticResource T.H2}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="Abra um jogo e escolha uma das opções de download disponíveis." Style="{StaticResource T.Body}" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="DoneHeader" Text="Concluídos" Style="{StaticResource T.H2}" Margin="6,18,0,14" />
            <ItemsControl x:Name="DoneList" ItemTemplate="{StaticResource DoneRow}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
