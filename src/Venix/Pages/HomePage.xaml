<UserControl x:Class="Venix.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Venix.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,8,28,32">

            <!-- ============================================ hero + stats -->
            <Grid Height="440">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- hero -->
                <Grid x:Name="Hero" Cursor="Hand" MouseLeftButtonUp="OnHeroClick">
                    <Border CornerRadius="30" Background="{DynamicResource Placeholder}" Effect="{StaticResource Shadow.Card}" />
                    <Border x:Name="HeroArt" CornerRadius="30">
                        <Border.Background>
                            <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00000000" Offset="0.25" />
                                <GradientStop Color="#8C08090A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- frosted copy of the art, clipped to the glass panel -->
                    <Grid core:Ui.ClipTo="{Binding ElementName=HeroPanel}" IsHitTestVisible="False">
                        <Border CornerRadius="30">
                            <Border.Background>
                                <ImageBrush x:Name="HeroBlurBrush" Stretch="UniformToFill" AlignmentY="Top" />
                            </Border.Background>
                            <Border.Effect><BlurEffect Radius="48" RenderingBias="Performance" /></Border.Effect>
                        </Border>
                    </Grid>

                    <Border x:Name="HeroPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22" Width="400"
                            CornerRadius="24" Padding="24,22" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#80FFFFFF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel>
                            <Border Style="{StaticResource Chip.Dark}" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock x:Name="HeroTag" Text="EM ALTA" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <Grid MinHeight="64" MaxHeight="96" HorizontalAlignment="Left">
                                <Image x:Name="HeroLogo" MaxWidth="300" MaxHeight="96" HorizontalAlignment="Left" Stretch="Uniform" />
                                <TextBlock x:Name="HeroTitle" Style="{StaticResource T.H1}" Foreground="White" FontSize="32" TextWrapping="Wrap"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock x:Name="HeroDesc" Foreground="#E6FFFFFF" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,18"
                                       MaxHeight="60" TextTrimming="WordEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Light}" Click="OnHeroClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ver jogo" />
                                        <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.ArrowUpRight}" FontSize="11" Margin="10,1,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="HeroOptions" Foreground="#CCFFFFFF" FontSize="12.5" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- pager -->
                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28" />
                </Grid>

                <!-- no list loaded -->
                <Border x:Name="NoLists" Style="{StaticResource Glass}" CornerRadius="30" Padding="44" Visibility="Collapsed">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                            <Border Width="60" Height="60" CornerRadius="20" Background="{DynamicResource Ink}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Link}" FontSize="20" Foreground="{DynamicResource Ink.Text}" />
                            </Border>
                            <TextBlock x:Name="NoListsTitle" Text="Nenhuma lista carregada" Style="{StaticResource T.H1}" FontSize="34" Margin="0,24,0,0" />
                            <TextBlock x:Name="NoListsText" Style="{StaticResource T.Body}" FontSize="14" Margin="0,10,0,26"
                                       Text="Os jogos do Venix vêm das suas listas de download. Coloque os arquivos .json na pasta sources (ao lado do Venix.exe) e recarregue." />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Primary}" Click="OnEditConfig" Padding="22,0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,10,0" />
                                        <TextBlock Text="Abrir pasta sources" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ReloadLists" Style="{StaticResource Btn}" Click="OnReloadLists" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Refresh}" FontSize="12" Margin="0,0,10,0" />
                                        <TextBlock Text="Recarregar" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- stats column -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Glass}" Padding="22,18">
                        <Grid>
                            <TextBlock Text="Títulos disponíveis" Style="{StaticResource T.Body}" Foreground="{DynamicResource Text}" />
                            <Button Style="{StaticResource Btn.Circle.Small}" Content="{x:Static core:Icons.ArrowUpRight}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="OnGoCatalog" />
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock x:Name="StatTitles" Text="0" Style="{StaticResource T.Big}" FontSize="40" />
                                <TextBlock x:Name="StatTitlesSub" Style="{StaticResource T.Label}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="22,18">
                        <Grid>
                            <TextBlock Text="Biblioteca" Style="{StaticResource T.Body}" Foreground="{DynamicResource Text}" />
                            <Button Style="{StaticResource Btn.Circle.Small}" Content="{x:Static core:Icons.ArrowUpRight}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="OnGoLibrary" />
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StatLib" Text="0" Style="{StaticResource T.Big}" FontSize="40" />
                                    <TextBlock Text="jogos" Style="{StaticResource T.Label}" VerticalAlignment="Bottom" Margin="8,0,0,10" />
                                </StackPanel>
                                <TextBlock x:Name="StatLibSub" Style="{StaticResource T.Label}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource Glass}" Padding="22,18" Background="{DynamicResource Ink}" BorderThickness="0">
                        <Grid>
                            <TextBlock Text="Downloads" Style="{StaticResource T.Body}" Foreground="{DynamicResource Ink.Text}" />
                            <Button Style="{StaticResource Btn.Circle.Small}" Content="{x:Static core:Icons.ArrowUpRight}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="OnGoDownloads" />
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock x:Name="StatDl" Text="0" Style="{StaticResource T.Big}" FontSize="40" Foreground="{DynamicResource Ink.Text}" />
                                <TextBlock x:Name="StatDlSub" Style="{StaticResource T.Label}" Opacity="0.8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================ continue playing -->
            <StackPanel x:Name="ContinueSection" Margin="0,36,0,0" Visibility="Collapsed">
                <TextBlock Text="Continue jogando" Style="{StaticResource T.H2}" Margin="8,0,0,8" />
                <ItemsControl x:Name="ContinueList" Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><core:ResponsiveGrid MinItemWidth="300" MaxRows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="core:LibraryGame">
                            <Button Click="OnContinue" Cursor="Hand" Margin="8" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Style="{StaticResource Glass}" Padding="10" CornerRadius="22">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="68" CornerRadius="14" Background="{DynamicResource Placeholder}">
                                                    <Border CornerRadius="14">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill" core:Img.DecodeWidth="260"
                                                                        core:Img.Urls="{Binding Converter={x:Static core:Conv.LibraryHeader}}" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Clock}" FontSize="11" Foreground="{DynamicResource Text.3}" />
                                                        <TextBlock Text="{Binding PlaytimeLabel}" Style="{StaticResource T.Label}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Glass.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============================================ discover -->
            <Grid x:Name="DiscoverHeader" Margin="8,36,8,10">
                <StackPanel>
                    <TextBlock Text="Descobrir" Style="{StaticResource T.H2}" />
                    <TextBlock Text="Jogos disponíveis nas suas listas" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Seg.Host}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" Content="Recentes" GroupName="disc" Tag="recent" IsChecked="True" Checked="OnTab" />
                            <RadioButton Style="{StaticResource Seg}" Content="Em alta" GroupName="disc" Tag="popular" Checked="OnTab" />
                            <RadioButton Style="{StaticResource Seg}" Content="Mais opções" GroupName="disc" Tag="options" Checked="OnTab" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Btn}" Click="OnSurprise" Margin="10,0,0,0" ToolTip="Abrir um jogo aleatório das listas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8B1;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Surpreenda-me" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="DiscoverStatus" Style="{StaticResource T.Label}" Margin="8,20" Text="Carregando…" />
            <ItemsControl x:Name="DiscoverList" ItemsPanel="{StaticResource TileGrid}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="core:Tile">
                        <Button Style="{StaticResource Tile}" Click="OnTile" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
