<UserControl x:Class="Venix.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Venix.Core"
             xmlns:local="clr-namespace:Venix.Pages">
    <!-- no outer ScrollViewer: the ListBox scrolls by itself so its rows stay virtualized -->
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- summary + search + kind tabs -->
        <Border Style="{StaticResource Glass}" Padding="26,22" CornerRadius="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="KindLabel" Text="Atualizações" Style="{StaticResource T.Label}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Total" Text="0" Style="{StaticResource T.Big}" />
                        <TextBlock x:Name="TotalUnit" Text="itens" Style="{StaticResource T.Label}" FontSize="13" VerticalAlignment="Bottom" Margin="10,0,0,11" />
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource Input}" Margin="40,0,24,0" VerticalAlignment="Center"
                         MaxWidth="520" Tag="Filtrar por jogo ou título…" core:Ui.Icon="{x:Static core:Icons.Search}" TextChanged="OnSearch" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Tipo" Style="{StaticResource T.Label}" Margin="6,0,0,6" />
                    <Border Style="{StaticResource Seg.Host}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabUpdates" Style="{StaticResource Seg}" Content="Atualizações" GroupName="kind" Tag="update" IsChecked="True" Checked="OnTab" />
                            <RadioButton x:Name="TabPatches" Style="{StaticResource Seg}" Content="Patches" GroupName="kind" Tag="patch" Checked="OnTab" />
                            <RadioButton x:Name="TabFixes" Style="{StaticResource Seg}" Content="Fixes" GroupName="kind" Tag="fix" Checked="OnTab" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- empty state -->
        <Border x:Name="Empty" Grid.Row="1" Style="{StaticResource Glass}" Margin="8,20,8,0" Padding="40" Visibility="Collapsed" CornerRadius="28">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Glass.Strong}" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Update}" FontSize="22" Foreground="{DynamicResource Text}" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource T.H2}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource T.Body}" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>
        </Border>

        <!-- rows (virtualized) -->
        <ListBox x:Name="List" Grid.Row="2" Margin="0,18,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="local:ExtraRow">
                    <Border x:Name="bd" CornerRadius="20" Padding="10" Margin="0,0,6,8" Background="{DynamicResource Glass.Soft}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OnRow" ToolTip="Abrir a página do jogo">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- small portrait cover of the base game -->
                            <Border Width="46" Height="62" CornerRadius="11" Background="{DynamicResource Placeholder}">
                                <Border CornerRadius="11">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill" core:Img.DecodeWidth="140" core:Img.Urls="{Binding Urls}" />
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameTitle}" Style="{StaticResource T.H3}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Text.2}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,-6">
                                    <Border Style="{StaticResource Chip}" Padding="9,2">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="4,0,0,6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Height="36" Padding="18,0" FontSize="12.5" VerticalAlignment="Center"
                                    Margin="12,0,4,0" Click="OnDownload" ToolTip="Escolher esta opção no diálogo de download">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Download}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Baixar" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Glass.Hover}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
