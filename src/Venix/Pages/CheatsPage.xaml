<UserControl x:Class="Venix.Pages.CheatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Venix.Core">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScroll">
        <StackPanel Margin="28,8,28,32">

            <!-- ============================================ stats -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Glass}" Padding="24,20">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Tabelas disponíveis" Style="{StaticResource T.Label}" />
                            <TextBlock x:Name="StatTables" Text="—" Style="{StaticResource T.Big}" />
                            <TextBlock x:Name="StatTablesSub" Style="{StaticResource T.Label}" />
                        </StackPanel>
                        <Button x:Name="RefreshBtn" Style="{StaticResource Btn.Circle.Small}" Content="{x:Static core:Icons.Sync}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Click="OnRefresh" ToolTip="Atualizar índice do GitHub" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="24,20" Background="{DynamicResource Ink}" BorderThickness="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Trainer Venix" Style="{StaticResource T.Label}" Foreground="{DynamicResource Ink.Text}" Opacity="0.6" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse x:Name="RunDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunStatus" Style="{StaticResource T.H2}" Foreground="{DynamicResource Ink.Text}" />
                            </StackPanel>
                            <TextBlock x:Name="RunInfo" Style="{StaticResource T.Label}" Foreground="{DynamicResource Ink.Text}" Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button x:Name="ResumeBtn" Style="{StaticResource Btn.Circle.Small}" Content="{x:Static core:Icons.ArrowUpRight}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Click="OnResume" ToolTip="Voltar ao trainer aberto" />
                    </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Glass}" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Glass.Strong}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Shield}" FontSize="17" Foreground="{DynamicResource Text}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Somente offline" Style="{StaticResource T.H3}" />
                            <TextBlock Style="{StaticResource T.Body}" FontSize="12.5" LineHeight="19" Margin="0,4,0,0"
                                       Text="Tabelas da comunidade aplicadas direto na memória pelo Venix. Use apenas em modos single-player / offline." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================ memory scanner -->
            <Border Style="{StaticResource Glass}" Padding="24,20" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Ink}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Search}" FontSize="17" Foreground="{DynamicResource Ink.Text}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <TextBlock Text="Scanner de memória" Style="{StaticResource T.H3}" />
                        <TextBlock Style="{StaticResource T.Body}" FontSize="12.5" LineHeight="19" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Sem tabela? Ache vida, dinheiro, munição ou stamina direto na memória do jogo: busca por valor ou descoberta automática guiada (perca vida → recupere → pronto). O Venix salva por jogo e reconecta sozinho." />
                        <WrapPanel x:Name="Profiles" Margin="0,10,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="Abrir scanner" Height="40" Padding="20,0" FontSize="13" VerticalAlignment="Top" Click="OnScanner" />
                </Grid>
            </Border>

            <!-- ============================================ toolbar -->
            <Grid Margin="0,26,0,10">
                <TextBox x:Name="Search" Style="{StaticResource Input}" MaxWidth="560" HorizontalAlignment="Left" Width="560"
                         Tag="Buscar jogo ou arquivo .ct…" core:Ui.Icon="{x:Static core:Icons.Search}" TextChanged="OnSearch" />
                <Border Style="{StaticResource Seg.Host}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Seg}" Content="Todas" GroupName="cf" IsChecked="True" Checked="OnScope" Tag="all" />
                        <RadioButton Style="{StaticResource Seg}" Content="Organizadas por jogo" GroupName="cf" Checked="OnScope" Tag="grouped" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="ResultInfo" Style="{StaticResource T.Label}" Margin="8,4,0,6" />

            <TextBlock x:Name="Status" Style="{StaticResource T.Body}" Margin="8,20" Text="Carregando índice do GitHub…" />

            <ItemsControl x:Name="List" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><core:ResponsiveGrid MinItemWidth="360" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="core:CheatTable">
                        <Button Click="OnTable" Cursor="Hand" Margin="8" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="22" Padding="14" Background="{DynamicResource Glass.Fill}"
                                            BorderBrush="{DynamicResource Glass.Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ic" Width="46" Height="46" CornerRadius="15" Background="{DynamicResource Glass.Strong}">
                                                <TextBlock x:Name="ict" Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.Cheat}" FontSize="16" Foreground="{DynamicResource Text}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Label}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Glass.Strong}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource T.Icon}" Text="{x:Static core:Icons.ArrowUpRight}" FontSize="11" Foreground="{DynamicResource Text.2}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Glass.Hover}" />
                                            <Setter TargetName="ic" Property="Background" Value="{DynamicResource Ink}" />
                                            <Setter TargetName="ict" Property="Foreground" Value="{DynamicResource Ink.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
