<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Graphite glass -->
    <LinearGradientBrush x:Key="Bg.Base" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#17181B" Offset="0" />
        <GradientStop Color="#111214" Offset="0.55" />
        <GradientStop Color="#0B0C0D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Bg.Blob1" Color="#3A3B40" Opacity="0.55" />
    <SolidColorBrush x:Key="Bg.Blob2" Color="#26272B" Opacity="0.8" />
    <SolidColorBrush x:Key="Bg.Blob3" Color="#4A3424" Opacity="0.25" />

    <SolidColorBrush x:Key="Glass.Fill" Color="#FFFFFF" Opacity="0.045" />
    <SolidColorBrush x:Key="Glass.Strong" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="Glass.Soft" Color="#FFFFFF" Opacity="0.03" />
    <SolidColorBrush x:Key="Glass.Hover" Color="#FFFFFF" Opacity="0.11" />
    <LinearGradientBrush x:Key="Glass.Border" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.5" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Line" Color="#FFFFFF" Opacity="0.07" />
    <SolidColorBrush x:Key="Line.Strong" Color="#FFFFFF" Opacity="0.13" />

    <SolidColorBrush x:Key="Text" Color="#F2F2F3" />
    <SolidColorBrush x:Key="Text.2" Color="#A4A6AD" />
    <SolidColorBrush x:Key="Text.3" Color="#6C6E75" />

    <SolidColorBrush x:Key="Ink" Color="#F1F1F2" />
    <SolidColorBrush x:Key="Ink.Hover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ink.Text" Color="#111214" />

    <SolidColorBrush x:Key="Track" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="Success" Color="#3DD07A" />
    <SolidColorBrush x:Key="Danger" Color="#FF5F63" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#FF5F63" Opacity="0.14" />
    <SolidColorBrush x:Key="Accent" Color="#FF8A33" />

    <Color x:Key="Shadow.Color">#000000</Color>
    <SolidColorBrush x:Key="Scrim" Color="#08090A" Opacity="0.55" />
    <SolidColorBrush x:Key="Placeholder" Color="#24252A" />
    <SolidColorBrush x:Key="Flyout.Fill" Color="#1B1C20" Opacity="0.97" />
</ResourceDictionary>
